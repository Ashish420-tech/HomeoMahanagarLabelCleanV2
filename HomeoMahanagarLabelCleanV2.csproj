<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <RootNamespace>HomeoMahanagarLabelCleanV2</RootNamespace>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Prevent duplicate assembly attribute errors in WPF projects -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <!-- Exclude test files from main project compilation -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />

    <!-- Also exclude the separate test project directory -->
    <Compile Remove="HomeoMahanagarLabelCleanV2.Tests\**" />
    <EmbeddedResource Remove="HomeoMahanagarLabelCleanV2.Tests\**" />
    <None Remove="HomeoMahanagarLabelCleanV2.Tests\**" />
    <Page Remove="HomeoMahanagarLabelCleanV2.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
      <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.2" />
  </ItemGroup>

</Project>
