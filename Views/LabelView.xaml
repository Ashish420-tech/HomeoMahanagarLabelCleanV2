<UserControl x:Class="HomeoMahanagarLabelCleanV2.Views.LabelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Expose the preview VM's PrintCommand via a local button binding -->
    </UserControl.Resources>

    <!-- 50mm x 30mm ≈ 189 x 113 px @96 DPI -->
    <Grid>
        <Border Width="189"
                Height="113"
                BorderThickness="1"
                BorderBrush="Black"
                CornerRadius="4"
                Padding="8"
                Background="White"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                ClipToBounds="True">

            <Canvas Width="189" Height="113" Background="White" ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding AdminLayout}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}"
                                       FontSize="{Binding FontSize}"
                                       FontWeight="{Binding IsBold, Converter={StaticResource BoolToFontWeightConverter}}"
                                       TextAlignment="{Binding Alignment}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>

        </Border>

        <!-- Simple print button bound to DataContext.PrintCommand if present -->
        <Button Content="Print" Width="60" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="4" Command="{Binding Preview.PrintCommand}" />
    </Grid>
</UserControl>
