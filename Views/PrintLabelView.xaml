<UserControl x:Class="HomeoMahanagarLabelCleanV2.Views.PrintLabelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dedicated print visual. Size is set from code before printing so it can
         match an exact physical label size (mm -> DIPs). This control is never
         shown on screen; it's constructed and measured/arranged prior to printing. -->
    <Border x:Name="RootBorder" Padding="0" Background="White" ClipToBounds="True" BorderThickness="0" CornerRadius="0">
        <Canvas x:Name="RootCanvas"
                Background="White"
                ClipToBounds="True" />
    </Border>

</UserControl>